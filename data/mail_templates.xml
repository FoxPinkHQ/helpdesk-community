<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_ticket_assigned" model="mail.template">
            <field name="name">Helpdesk Ticket: Assigned</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">Ticket {{ object.ticket_number }} assigned to you</field>
            <field name="partner_to" eval="[(4, ref('helpdesk.group_helpdesk_user'))]"/>
            <field name="auto_delete" eval="True"/>
            <field name="body_html">
                <![CDATA[
<p>Hello,</p>
<p>Ticket <strong>${object.ticket_number}</strong> has been assigned to you.</p>
<p><strong>Subject:</strong> ${object.name}</p>
<p><strong>Priority:</strong> ${object.priority}</p>
<p t-if="object.description">
    <strong>Description:</strong><br/>
    ${object.description}
</p>
<a href="${object.get_base_url()}/web#id=${object.id}&model=helpdesk.ticket&view_type=form">
    View Ticket
</a>
]]>
            </field>
        </record>

        <record id="email_template_ticket_stage_change" model="mail.template">
            <field name="name">Helpdesk Ticket: Stage Change</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">Ticket {{ object.ticket_number }} moved to {{ object.stage_id.name }}</field>
            <field name="email_to">${object.partner_id.email or ''}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html">
                <![CDATA[
<p>Hello ${object.partner_id.name or ''},</p>
<p>Your ticket <strong>${object.ticket_number}</strong> has been updated.</p>
<p><strong>Status:</strong> ${object.stage_id.name}</p>
<p><strong>Subject:</strong> ${object.name}</p>
<a href="${object.get_base_url()}/my/ticket/${object.id}">
    View Ticket
</a>
]]>
            </field>
        </record>
    </data>
</odoo>
