<!-- R-VIEW-002 expected <=17.0: no <card> element, legacy t-name="kanban-box"
     wrapping <div class="oe_kanban_card">. Applies to 16.0, 15.0, 14.0. -->
<kanban class="o_helpdesk_kanban" default_group_by="stage_id">
    <field name="name"/>
    <templates>
        <t t-name="kanban-box">
            <div class="oe_kanban_card">
                <field name="name"/>
            </div>
        </t>
    </templates>
</kanban>
