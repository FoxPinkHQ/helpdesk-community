<!-- R-VIEW-002 golden (19.0): kanban uses <card> element (t-name="card" canonical) -->
<kanban class="o_helpdesk_kanban" default_group_by="stage_id">
    <field name="name"/>
    <templates>
        <t t-name="card">
            <card class="oe_kanban_card">
                <field name="name"/>
            </card>
        </t>
    </templates>
</kanban>
