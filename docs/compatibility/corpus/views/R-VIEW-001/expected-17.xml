<!-- R-VIEW-001 expected <=17.0: <list> -> <tree>, view_mode "list" -> "tree".
     Same fixture applies to 16.0, 15.0, 14.0. -->
<record id="view_helpdesk_ticket_tree" model="ir.ui.view">
    <field name="name">helpdesk.ticket.tree</field>
    <field name="model">helpdesk.ticket</field>
    <field name="arch" type="xml">
        <tree>
            <field name="ticket_number"/>
            <field name="name"/>
            <field name="stage_id"/>
        </tree>
    </field>
</record>
<record id="action_helpdesk_ticket_tree" model="ir.actions.act_window">
    <field name="name">Tickets</field>
    <field name="res_model">helpdesk.ticket</field>
    <field name="view_mode">kanban,tree,form</field>
</record>
