<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_ticket_assigned" model="mail.template">
            <field name="name">Helpdesk Ticket: Assigned</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">Ticket ${object.ticket_number or ''} assigned to you</field>
            <field name="email_to">${object.user_id.email or ''}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hello,</p>
                    <p>Ticket <strong>${object.ticket_number or ''}</strong> has been assigned to you.</p>
                    <p><strong>Subject:</strong> ${object.name or ''}</p>
                    <p><strong>Priority:</strong> ${object.priority or ''}</p>
                    % if object.description:
                    <p><strong>Description:</strong></p>
                    <div>${object.description or ''}</div>
                    % endif
                    <p><a href="/web#id=${object.id}&amp;model=helpdesk.ticket&amp;view_type=form">View Ticket</a></p>
                </div>
            </field>
        </record>

        <record id="email_template_ticket_stage_change" model="mail.template">
            <field name="name">Helpdesk Ticket: Stage Change</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="subject">Ticket ${object.ticket_number or ''} moved to ${object.stage_id.name or ''}</field>
            <field name="email_to">${object.partner_id.email or ''}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hello ${object.partner_id.name or ''},</p>
                    <p>Your ticket <strong>${object.ticket_number or ''}</strong> has been updated.</p>
                    <p><strong>Status:</strong> ${object.stage_id.name or ''}</p>
                    <p><strong>Subject:</strong> ${object.name or ''}</p>
                    <p><a href="/my/ticket/${object.id}">View Ticket</a></p>
                </div>
            </field>
        </record>
    </data>
</odoo>